<?xml version="1.0" encoding="utf-8"?>
<!--
   Financial data is user-sensitive and the app provides its own JSON export;
   exclude the Room database and its WAL/shm sidecars from cloud backups.
-->
<full-backup-content>
    <include domain="sharedpref" path="."/>
    <include domain="database" path="."/>
    <exclude domain="database" path="martinu_financials_db"/>
    <exclude domain="database" path="martinu_financials_db-wal"/>
    <exclude domain="database" path="martinu_financials_db-shm"/>
</full-backup-content>
