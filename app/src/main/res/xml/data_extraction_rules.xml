<?xml version="1.0" encoding="utf-8"?>
<!--
   Financial data is user-sensitive: all databases and SharedPreferences are excluded from cloud backup.
   Device-to-device transfer includes the Room database and auxiliary user preference stores (investment lots,
   dismissed subscriptions, and bank balances) so users keep their complete local data when migrating phones.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="."/>
        <exclude domain="sharedpref" path="statement_import_prefs.xml"/>
        <exclude domain="sharedpref" path="subscription_auditor_prefs.xml"/>
        <exclude domain="database" path="."/>
        <exclude domain="database" path="martinu_financials_db"/>
        <exclude domain="database" path="martinu_financials_db-wal"/>
        <exclude domain="database" path="martinu_financials_db-shm"/>
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="."/>
        <include domain="sharedpref" path="investment_lots_prefs.xml"/>
        <include domain="sharedpref" path="subscription_auditor_prefs.xml"/>
        <include domain="sharedpref" path="statement_import_prefs.xml"/>
        <include domain="sharedpref" path="merchant_category_overrides.xml"/>
        <include domain="sharedpref" path="app_theme_prefs.xml"/>
    </device-transfer>
</data-extraction-rules>
